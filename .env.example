# ==============================================================================
# TasKode Production & Development Environment Configuration
# ==============================================================================

# Core Django Settings
# Generate a secure random string for production (e.g. `openssl rand -hex 32`)
SECRET_KEY=your-super-secret-django-key-change-in-production

# Set to False in production!
DEBUG=False

# Comma-separated list of hostnames/domains permitted to access the app
# In production, set to your Render domain, e.g.: taskode.onrender.com
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,.onrender.com

# Comma-separated trusted origins for CSRF protection on HTTPS domains
# E.g. https://taskode.onrender.com
CSRF_TRUSTED_ORIGINS=https://*.onrender.com,http://localhost:8000

# Database Configuration (via dj-database-url)
# Leave empty or unset for local SQLite (`db.sqlite3`).
# For production, paste your Neon or Supabase PostgreSQL connection string:
# DATABASE_URL=postgresql://user:password@ep-sample-123456.neon.tech/taskode?sslmode=require
DATABASE_URL=

# Redis & Celery Cache / Broker
# Leave empty for in-memory cache and synchronous Celery execution (ideal for single free dynos)
# For production with Upstash or cloud Redis, supply the rediss:// connection URL:
# REDIS_URL=rediss://default:your-token@your-endpoint.upstash.io:6379
REDIS_URL=

# ChromaDB Vector Database
# By default, falls back to persistent on-disk storage at `./chroma_data`.
# When running with Docker Compose, set CHROMA_HOST=chromadb
CHROMA_HOST=chromadb
CHROMA_PORT=8000

# AI / Google Gemini
# Required for RAG code retrieval and natural language ticket generation
GEMINI_API_KEY=your-google-gemini-api-key-here

# Email Configuration (for 2FA OTP codes)
# Defaults to console backend in development. For production, set SMTP credentials:
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@taskode.com
