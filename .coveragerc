[run]
source = coresite
omit =
    */migrations/*
    */tests.py
    */test_*.py
    */__pycache__/*
    conftest.py
    manage.py
    myproject/asgi.py
    myproject/wsgi.py

[report]
show_missing = True
skip_covered = False
exclude_lines =
    pragma: no cover
    def __repr__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
