        {
          "name": "2FA Step 2: Verify OTP Code",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const jsonData = pm.response.json();",
                  "if (jsonData.access) {",
                  "    pm.collectionVariables.set(\"access_token\", jsonData.access);",
                  "    pm.collectionVariables.set(\"refresh_token\", jsonData.refresh);",
                  "    console.log(\"[TasKode] 2FA verified successfully! Tokens updated.\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"session_token\": \"{{session_token}}\",\n  \"otp\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/2fa/verify/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "2fa", "verify", ""]
            },
            "description": "Verifies the 6-digit OTP code against the session token. Upon success, issues JWT tokens."
          },
          "response": []
        },
        {
          "name": "2FA: Resend OTP Code",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const jsonData = pm.response.json();",
                  "if (jsonData.session_token) {",
                  "    pm.collectionVariables.set(\"session_token\", jsonData.session_token);",
                  "    console.log(\"[TasKode] Stored new session_token after resend: \" + jsonData.session_token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"session_token\": \"{{session_token}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/2fa/resend/",
