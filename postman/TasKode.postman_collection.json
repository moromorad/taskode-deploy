              "mode": "raw",
              "raw": "{\n  \"username\": \"testuser_{{$randomInt}}\",\n  \"email\": \"testuser_{{$randomInt}}@example.com\",\n  \"password\": \"TasKodePass123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/register/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "register", ""]
            },
            "description": "Creates a new user account and directly returns access and refresh tokens."
          },
          "response": []
        },
